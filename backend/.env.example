APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
VECTOR_DB_PATH=./data/vectorstore
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported values: ollama | gemini | openai
LLM_PROVIDER=ollama

# Ollama (local development)
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (deployment) — set LLM_PROVIDER=gemini and fill in key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional) — set LLM_PROVIDER=openai and fill in key
OPENAI_API_KEY=

# ── RAG settings ──────────────────────────────────────────────────────────────
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.5
TEMPERATURE=0.1
PROMPT_VERSION=v1
MAX_FILE_SIZE_MB=50
LOG_LEVEL=INFO
MAX_QUESTION_LENGTH=2000
RATE_LIMIT_PER_MINUTE=30
