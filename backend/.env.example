APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
VECTOR_DB_PATH=./data/vectorstore
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Supported values: ollama | gemini | openai
LLM_PROVIDER=ollama

# Ollama (local development)
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gemini (deployment) — set LLM_PROVIDER=gemini and fill in key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (optional) — set LLM_PROVIDER=openai and fill in key
OPENAI_API_KEY=

# ── Web Search ────────────────────────────────────────────────────────────────
# Tavily API key for real-time web search — get one at https://tavily.com
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# ── RAG settings ──────────────────────────────────────────────────────────────
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.5
TEMPERATURE=0.1
PROMPT_VERSION=v1
MAX_FILE_SIZE_MB=50
LOG_LEVEL=INFO
MAX_QUESTION_LENGTH=2000
RATE_LIMIT_PER_MINUTE=30
